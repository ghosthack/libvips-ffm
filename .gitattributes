# repository is checked out on Windows.
*.sh text eol=lf
*.py text eol=lf
*.patch text eol=lf
*.cmake text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.env text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.h text eol=lf
mvnw text eol=lf
*.cmd text eol=crlf
