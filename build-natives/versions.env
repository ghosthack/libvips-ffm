# vcpkg builds the remaining dependency closure from source. Its port files
# pin and checksum every source archive they acquire.
VCPKG_COMMIT=3c5d90a305ff00ca841f085a74a7ce74ee777dee

# PDFium is built from Chromium source by the pinned pdfium-binaries build
# scripts, without V8 or XFA. chromium/7869 corresponds to 150.0.7869.0.
# This is the helper repository's chromium/7869 tag. Pinning the matching
# helper revision matters because later tags use a different checkout shape.
PDFIUM_BUILD_COMMIT=9c061bee16814c28de781335b13d5dbd3a089b39
PDFIUM_BRANCH=chromium/7869
PDFIUM_REVISION=80fccd7553e5cff9cea6549bc0db2ea93ea6cb2e
PDFIUM_VERSION=150.0.7869.0
