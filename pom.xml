<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.ghosthack</groupId>
  <artifactId>libvips-ffm-parent</artifactId>
  <version>8.18.3-0.1.3</version>
  <packaging>pom</packaging>

  <name>libvips-ffm parent</name>
  <description>JDK 26 Panama FFM bindings for libvips with bundled native libraries</description>
  <url>https://github.com/ghosthack/libvips-ffm</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/license/mit</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>ghosthack</id>
      <name>ghosthack</name>
      <url>https://github.com/ghosthack</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/ghosthack/libvips-ffm.git</connection>
    <developerConnection>scm:git:git@github.com:ghosthack/libvips-ffm.git</developerConnection>
    <url>https://github.com/ghosthack/libvips-ffm</url>
    <tag>v${project.version}</tag>
  </scm>

  <modules>
    <module>natives</module>
    <module>core</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.build.outputTimestamp>2026-07-31T00:00:00Z</project.build.outputTimestamp>
    <maven.resources.propertiesEncoding>UTF-8</maven.resources.propertiesEncoding>
    <maven.compiler.release>26</maven.compiler.release>
    <libvips.version>8.18.3</libvips.version>
    <native.classifier>macos-arm64</native.classifier>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.15.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.4</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.2</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <id>supported-build-toolchain</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.9.0,4.0.0)</version>
                </requireMavenVersion>
                <requireJavaVersion>
                  <version>[26,27)</version>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.4.0</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.12.0</version>
            <configuration>
              <doclint>none</doclint>
              <quiet>true</quiet>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>macos-arm64</id>
      <activation>
        <os><family>mac</family><arch>aarch64</arch></os>
      </activation>
      <properties><native.classifier>macos-arm64</native.classifier></properties>
    </profile>
    <profile>
      <id>windows-x64</id>
      <activation>
        <os><family>windows</family><arch>amd64</arch></os>
      </activation>
      <properties><native.classifier>windows-x64</native.classifier></properties>
    </profile>
    <profile>
      <id>linux-x64</id>
      <activation>
        <os><family>unix</family><name>linux</name><arch>amd64</arch></os>
      </activation>
      <properties><native.classifier>linux-x64</native.classifier></properties>
    </profile>
  </profiles>
</project>
